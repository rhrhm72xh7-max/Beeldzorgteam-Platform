ion-colors rounded-full nav-link transform active:scale-95 hover:bg-primary-200" aria-label="Navigeer naar Partners" data-v-cc455ec7>Partners</a><a href="/contact" class="z-10 relative inline-block px-4 py-3 leading-none  text-primary-900 no-underline text-sm font-medium transition-colors rounded-full nav-link transform active:scale-95 bg-primary-950 !text-primary-50 ml-2" aria-label="Navigeer naar Contact met ons opnemen" data-v-cc455ec7>Contact</a><!----></nav><button class="md:hidden p-2 rounded-md transition-colors z-10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 text-primary-950 hover:text-primary-800 hover:bg-primary-100 focus-visible:ring-primary-950" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-navigation"><div class="w-6 h-6 relative flex items-center justify-center"><span class="absolute w-5 h-0.5 bg-current rounded-full transition-all duration-300 ease-out -translate-y-1"></span><span class="absolute w-5 h-0.5 bg-current rounded-full transition-all duration-300 ease-out translate-y-1"></span></div></button></div></div></nav><!----><!--]--><div class="min-h-screen bg-primary-50"><section class="py-8 md:py-24 pt-24 pb-8 md:pb-16 md:pt-40"><!--[--><div class="w-full max-w-6xl mx-auto px-4"><!--[--><div class="max-w-3xl mx-auto text-center"><!----><div class="mb-4"><span class="inline-block font-medium rounded-full bg-primary-100 text-primary-800 px-3 py-1 text-xs">Zorg op Afstand</span></div><h1 class="text-4xl md:text-5xl lg:text-6xl tracking-tight font-medium text-primary-950 mb-6 text-balance">Automatiseer zorgtrajecten die zich aanpassen aan elke cliënt</h1><p class="text-lg md:text-xl text-primary-700 text-balance mb-8">Bouw gestructureerde programma's. Beeldbellen loopt op de achtergrond, zodat jouw team zich op de zorg kan richten.</p><div><!--[--><a href="/contact" class="cursor-pointer leading-none inline-flex items-center justify-center font-medium transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 whitespace-nowrap px-4 py-3 md:py-3 bg-primary-950 text-primary-50 rounded-full hover:bg-primary-900 focus-visible:ring-primary-950 active:scale-95 text-base"><!--[--> Neem contact op <!--]--><!----></a><!--]--></div></div><!--]--><!----></div><!--]--></section><section class="py-8 md:py-24"><!--[--><div class="w-full max-w-6xl mx-auto px-4"><!--[--><div class="max-w-4xl mx-auto"><div class="w-full"><div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-2 lg:gap-6 text-pretty"><div class="flex flex-col items-start text-left flex-1"><span class="inline-block font-medium rounded-full bg-primary-100 text-primary-800 px-3 py-1 text-xs mb-3">Probleem</span><h2 class="text-2xl md:max-w-[24ch] tracking-tight md:text-4xl font-medium text-primary-950 mb-3">handmatige opvolging is niet schaalbaar</h2><!----></div><!----></div></div><div class="mt-8 space-y-4 text-base text-primary-700"><p> Zorgteams weten wat cliënten nodig hebben, maar consistente levering is lastig. Handmatige processen schieten tekort. </p><p> Beeldbellen vervangt handmatige coördinatie door automatisering. Bepaal het traject één keer, en elke cliënt doorloopt het op eigen tempo. </p></div><div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12"><!--[--><div class="flex flex-col text-pretty"><span class="text-3xl md:text-5xl text-primary-950 tracking-tight font-[300]">2:1</span><h3 class="font-medium text-primary-900 mt-4">Uren aan papierwerk per uur patiëntenzorg</h3><p class="text-sm text-primary-700 mt-1">Artsen besteden ongeveer 2 uur aan elektronische documentatie en administratieve taken voor elk uur directe patiëntenzorg.</p><a href="https://pmc.ncbi.nlm.nih.gov/articles/PMC10134123/" target="_blank" rel="noopener noreferrer" class="inline items-center gap-1 font-medium text-primary-600 hover:text-primary-950 transition-colors text-xs mt-auto tracking-tight pt-2"><!--[-->Annalen van de interne geneeskunde<span>, 2023</span><!--]--><span class="iconify i-ph:arrow-up-right relative transform translate-y-[2px] translate-x-[1px] w-3 h-3" aria-hidden="true" style=""></span></a></div><div class="flex flex-col text-pretty"><span class="text-3xl md:text-5xl text-primary-950 tracking-tight font-[300]">2x</span><h3 class="font-medium text-primary-900 mt-4">Direct contact verdubbelt therapietrouw</h3><p class="text-sm text-primary-700 mt-1">Onderzoek toont aan dat laagdrempelige contact, de therapietrouw verdubbelt en de betrokkenheid vergroot.</p><a href="https://pmc.ncbi.nlm.nih.gov/articles/PMC12096470/" target="_blank" rel="noopener noreferrer" class="inline items-center gap-1 font-medium text-primary-600 hover:text-primary-950 transition-colors text-xs mt-auto tracking-tight pt-2"><!--[-->PMC / a:zorg Congress<span>, 2024</span><!--]--><span class="iconify i-ph:arrow-up-right relative transform translate-y-[2px] translate-x-[1px] w-3 h-3" aria-hidden="true" style=""></span></a></div><div class="flex flex-col text-pretty"><span class="text-3xl md:text-5xl text-primary-950 tracking-tight font-[300]">6:1</span><h3 class="font-medium text-primary-900 mt-4">Rendement op gezamenlijke zorginvesteringen</h3><p class="text-sm text-primary-700 mt-1">Collaboratieve zorgmodellen waarin gedragsmatige zorg is geïntegreerd, besparen ongeveer $ 6 op elke geïnvesteerde $ 1, met 11% minder ziekenhuisopnames en 23% minder bezoeken aan de spoedeisende hulp.</p><a href="https://jamanetwork.com/journals/jamanetworkopen/fullarticle/2829859" target="_blank" rel="noopener noreferrer" class="inline items-center gap-1 font-medium text-primary-600 hover:text-primary-950 transition-colors text-xs mt-auto tracking-tight pt-2"><!--[-->JAMA-netwerk geopend<span>, 2025</span><!--]--><span class="iconify i-ph:arrow-up-right relative transform translate-y-[2px] translate-x-[1px] w-3 h-3" aria-hidden="true" style=""></span></a></div><!--]--></div></div><!--]--><!----></div><!--]--></section><section class="py-8 md:py-24"><!--[--><div class="w-full max-w-6xl mx-auto px-4 mb-12 md:mb-16"><!--[--><div class="w-full"><div class="flex flex-col items-center text-balance"><div class="flex flex-col items-center text-center"><!----><h2 class="text-2xl md:max-w-[24ch] tracking-tight md:text-4xl font-medium text-primary-950 mb-3">Eén keer instellen, voor elke cliënt beschikbaar</h2><p class="text-base text-primary-700 md:max-w-[60ch] text-balance">Eenvoudig inplannen van 1-op-1 gesprekken en groepsbellen.</p></div><div class="mt-6"><!--[--><a href="/contact" class="cursor-pointer leading-none inline-flex items-center justify-center font-medium transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 whitespace-nowrap px-4 py-3 md:py-3 bg-primary-950 text-primary-50 rounded-full hover:bg-primary-900 focus-visible:ring-primary-950 active:scale-95 text-sm"><!--[-->Neem contact op<!--]--><!----></a><!--]--></div></div></div><!--]--><!----></div><div class="flex flex-col gap-8 md:gap-16 w-full"><div class="w-full max-w-6xl mx-auto px-4"><!--[--><div class="space-y-16 md:space-y-24 w-full"><!--[--><div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-20 items-center"><div class="max-w-md"><span class="inline-block font-medium rounded-full bg-primary-100 text-primary-800 px-3 py-1 text-xs mb-4">Videoconsulten</span><h3 class="text-xl md:text-2xl font-medium text-primary-950 mb-4 text-pretty">Direct en eenvoudig videobellen</h3><p class="text-base text-primary-700 text-balance">Plan 1-op-1 gesprekken of groepsbellen met één klik. Het volledige zorgtraject blijft overzichtelijk met duidelijke en laagdrempelige verbindingen voor de cliënt.</p><!----></div><figure class=""><div class="bg-primary-100 rounded-xl aspect-[4/3] overflow-hidden"><img data-nuxt-img srcset="/_amplify/image?url=%2Fimages%2Fbeeldzorg_workflows_1.jpg&amp;w=1536&amp;q=100 1x, /_amplify/image?url=%2Fimages%2Fbeeldzorg_workflows_1.jpg&amp;w=1536&amp;q=100 2x" onerror="this.setAttribute(&#39;data-error&#39;, 1)" alt="Direct en eenvoudig videobellen" class="w-full h-full object-contain" src="/_amplify/image?url=%2Fimages%2Fbeeldzorg_workflows_1.jpg&amp;w=1536&amp;q=100"></div></figure></div><div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-20 items-center"><div class="md:order-2 max-w-md"><span class="inline-block font-medium rounded-full bg-primary-100 text-primary-800 px-3 py-1 text-xs mb-4">Flexibiliteit</span><h3 class="text-xl md:text-2xl font-medium text-primary-950 mb-4 text-pretty">Persoonlijke zorg op maat</h3><p class="text-base text-primary-700 text-balance">Stem de zorg naadloos af op de behoefte van de cliënt. Pas contactmomenten aan op basis van welzijn en betrokkenheid, zodat elke cliënt de juiste aandacht krijgt op het juiste moment.</p><!----></div><figure class="md:order-1"><div class="bg-primary-100 rounded-xl aspect-[4/3] overflow-hidden"><img data-nuxt-img srcset="/_amplify/image?url=%2Fimages%2Fbeeldzorg_workflows_2.jpg&amp;w=1536&amp;q=100 1x, /_amplify/image?url=%2Fimages%2Fbeeldzorg_workflows_2.jpg&amp;w=1536&amp;q=100 2x" onerror="this.setAttribute(&#39;data-error&#39;, 1)" alt="Persoonlijke zorg op maat" class="w-full h-full object-contain" src="/_amplify/image?url=%2Fimages%2Fbeeldzorg_workflows_2.jpg&amp;w=1536&amp;q=100"></div></figure></div><div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-20 items-center"><div class="max-w-md"><span class="inline-block font-medium rounded-full bg-primary-100 text-primary-800 px-3 py-1 text-xs mb-4">Check-ins</span><h3 class="text-xl md:text-2xl font-medium text-primary-950 mb-4 text-pretty">Warme check-ins voor continue betrokkenheid</h3><p class="text-base text-primary-700 text-balance">Blijf eenvoudig in contact met korte, persoonlijke check-ins. Hiermee geef je cliënten het gevoel dat er altijd iemand is, wat zorgt voor een veiliger en vertrouwder gevoel thuis.</p><!----></div><figure class=""><div class="bg-primary-100 rounded-xl aspect-[4/3] overflow-hidden"><img data-nuxt-img srcset="/_amplify/image?url=%2Fimages%2Fbeeldzorg_workflows_3.jpg&amp;w=1536&amp;q=100 1x, /_amplify/image?url=%2Fimages%2Fbeeldzorg_workflows_3.jpg&amp;w=1536&amp;q=100 2x" onerror="this.setAttribute(&#39;data-error&#39;, 1)" alt="Warme check-ins voor continue betrokkenheid" class="w-full h-full object-contain" src="/_amplify/image?url=%2Fimages%2Fbeeldzorg_workflows_3.jpg&amp;w=1536&amp;q=100"></div></figure></div><div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-20 items-center"><div class="md:order-2 max-w-md"><span class="inline-block font-medium rounded-full bg-primary-100 text-primary-800 px-3 py-1 text-xs mb-4">Welkom</span><h3 class="text-xl md:text-2xl font-medium text-primary-950 mb-4 text-pretty">Een warm welkom voor elke cliënt</h3><p class="text-base text-primary-700 text-balance">Zodra een cliënt start, staan we klaar met een warm en persoonlijk welkom. Directe en duidelijke communicatie zorgt ervoor dat zij zich direct op hun gemak voelen in de nieuwe omgeving.</p><!----></div><figure class="md:order-1"><div class="bg-primary-100 rounded-xl aspect-[4/3] overflow-hidden"><img data-nuxt-img srcset="/_amplify/image?url=%2Fimages%2Fbeeldzorg_workflows_4.jpg&amp;w=1536&amp;q=100 1x, /_amplify/image?url=%2Fimages%2Fbeeldzorg_workflows_4.jpg&amp;w=1536&amp;q=100 2x" onerror="this.setAttribute(&#39;data-error&#39;, 1)" alt="Een warm welkom voor elke cliënt" class="w-full h-full object-contain" src="/_amplify/image?url=%2Fimages%2Fbeeldzorg_workflows_4.jpg&amp;w=1536&amp;q=100"></div></figure></div><div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-20 items-center"><div class="max-w-md"><span class="inline-block font-medium rounded-full bg-primary-100 text-primary-800 px-3 py-1 text-xs mb-4">Inzicht</span><h3 class="text-xl md:text-2xl font-medium text-primary-950 mb-4 text-pretty">Direct inzicht in het welzijn van de cliënt</h3><p class="text-base text-primary-700 text-balance">Zie direct hoe het met je cliënten gaat. Krijg overzicht in contactmomenten en welzijn, zodat je precies weet waar en wanneer extra aandacht of een warm gesprek gewenst is.</p><!----></div><figure class=""><div class="bg-primary-100 rounded-xl aspect-[4/3] overflow-hidden"><img data-nuxt-img srcset="/_amplify/image?url=%2Fimages%2Fbeeldzorg_workflows_1.jpg&amp;w=1536&amp;q=100 1x, /_amplify/image?url=%2Fimages%2Fbeeldzorg_workflows_1.jpg&amp;w=1536&amp;q=100 2x" onerror="this.setAttribute(&#39;data-error&#39;, 1)" alt="Direct inzicht in het welzijn van de cliënt" class="w-full h-full object-contain" src="/_amplify/image?url=%2Fimages%2Fbeeldzorg_workflows_1.jpg&amp;w=1536&amp;q=100"></div></figure></div><!--]--></div><!--]--><!----></div></div><!--]--></section><section class="py-8 md:py-24 bg-primary-100/50"><!--[--><div class="w-full max-w-6xl mx-auto px-4"><!--[--><div class="grid grid-cols-1 md:grid-cols-6 gap-8 md:gap-16 lg:gap-24 items-center"><figure class="order-2 md:col-span-4 space-y-4 md:space-y-6"><blockquote class="text-xl sm:text-2xl lg:text-3xl xl:text-4xl max-w-full sm:max-w-[40ch] font-medium text-primary-900 text-pretty tracking-tight [&amp;_i]:not-italic [&amp;_i]:bg-gradient-to-r [&amp;_i]:from-primary-200/70 [&amp;_i]:to-primary-300/70 [&amp;_i]:px-1 [&amp;_i]:-mx-1 [&amp;_i]:rounded [&amp;_i]:box-decoration-clone [&amp;_i]:border-r-4 [&amp;_i]:border-primary-400">"Vroeger waren we veel tijd kwijt aan het bellen van cliënten en hopen dat ze zich aan het traject hielden. Nu zetten we één keer een traject op en <i>elke cliënt krijgt dezelfde warme en consistente begeleiding</i> zonder dat het ons team extra tijd kost."</blockquote><figcaption class="md:order-2"><cite class="text-sm sm:text-base font-medium text-primary-950 not-italic">Ralph Van der Pol</cite><p class="text-xs sm:text-sm text-primary-600">Oprichter Beeldzorgteam</p></figcaption><a href="https://kuduzorg.com" rel="noopener noreferrer" target="_blank" class="inline-block"><img data-nuxt-img srcset="/_amplify/image?url=%2Fimages%2Fkuduzorg-logo.png&amp;w=