transition-colors rounded-full nav-link transform active:scale-95 hover:bg-primary-200" aria-label="Navigeer naar Partners" data-v-cc455ec7>Partners</a><a href="/contact" class="z-10 relative inline-block px-4 py-3 leading-none  text-primary-900 no-underline text-sm font-medium transition-colors rounded-full nav-link transform active:scale-95 bg-primary-950 !text-primary-50 ml-2" aria-label="Navigeer naar Contact met ons opnemen" data-v-cc455ec7>Contact</a><!----></nav><button class="md:hidden p-2 rounded-md transition-colors z-10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 text-primary-950 hover:text-primary-800 hover:bg-primary-100 focus-visible:ring-primary-950" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-navigation"><div class="w-6 h-6 relative flex items-center justify-center"><span class="absolute w-5 h-0.5 bg-current rounded-full transition-all duration-300 ease-out -translate-y-1"></span><span class="absolute w-5 h-0.5 bg-current rounded-full transition-all duration-300 ease-out translate-y-1"></span></div></button></div></div></nav><!----><!--]--><div class="min-h-screen bg-primary-50"><section class="py-8 md:py-24 pt-24 pb-8 md:pb-16 md:pt-40"><!--[--><div class="w-full max-w-6xl mx-auto px-4"><!--[--><div class="max-w-3xl mx-auto text-center"><!----><div class="mb-4"><span class="inline-block font-medium rounded-full bg-primary-100 text-primary-800 px-3 py-1 text-xs">Veilig Cliëntportaal</span></div><h1 class="text-4xl md:text-5xl lg:text-6xl tracking-tight font-medium text-primary-950 mb-6 text-balance">Veilig en overzichtelijk beeldbellen voor cliënten</h1><p class="text-lg md:text-xl text-primary-700 text-balance mb-8">Cliënten loggen direct in op hun afspraak zonder gedoe met apps of moeilijke wachtwoorden. Een veilige link is genoeg.</p><div><!--[--><a href="/contact" class="cursor-pointer leading-none inline-flex items-center justify-center font-medium transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 whitespace-nowrap px-4 py-3 md:py-3 bg-primary-950 text-primary-50 rounded-full hover:bg-primary-900 focus-visible:ring-primary-950 active:scale-95 text-base"><!--[--> Neem contact op <!--]--><!----></a><!--]--></div></div><!--]--><!----></div><!--]--></section><section class="py-8 md:py-24"><!--[--><div class="w-full max-w-6xl mx-auto px-4"><!--[--><div class="max-w-4xl mx-auto"><div class="w-full"><div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-2 lg:gap-6 text-pretty"><div class="flex flex-col items-start text-left flex-1"><span class="inline-block font-medium rounded-full bg-primary-100 text-primary-800 px-3 py-1 text-xs mb-3">Probleem</span><h2 class="text-100%l md:max-w-[24ch] tracking-tight md:text-4xl font-medium text-primary-950 mb-3">Toegankelijke zorg op afstand</h2><!----></div><!----></div></div><div class="mt-8 space-y-4 text-base text-primary-700"><p> Traditionele beeldbel-oplossingen zijn vaak complex voor cliënten, wat zorgt voor stress voor de afspraak. </p><p> Het Beeldzorgteam platform neemt die drempel weg. Cliënten krijgen een overzichtelijke omgeving, die direct werkt op elk apparaat. </p></div><div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12"><!--[--><div class="flex flex-col text-pretty"><span class="text-3xl md:text-5xl text-primary-950 tracking-tight font-[300]">98%</span><h3 class="font-medium text-primary-900 mt-4">Geslaagde beeldbelverbindingen</h3><p class="text-sm text-primary-700 mt-1">Dankzij onze gebruiksvriendelijke interface logt vrijwel elke cliënt in één keer succesvol in.</p><a href="https://www.panfoundation.org/medication-non-adherence/" target="_blank" rel="noopener noreferrer" class="inline items-center gap-1 font-medium text-primary-600 hover:text-primary-950 transition-colors text-xs mt-auto tracking-tight pt-2"><!--[-->Wereldzorgorganisatie<span>, 2023</span><!--]--><span class="iconify i-ph:arrow-up-right relative transform translate-y-[2px] translate-x-[1px] w-3 h-3" aria-hidden="true" style=""></span></a></div><div class="flex flex-col text-pretty"><span class="text-3xl md:text-5xl text-primary-950 tracking-tight font-[300]">0</span><h3 class="font-medium text-primary-900 mt-4">Installaties nodig</h3><p class="text-sm text-primary-700 mt-1">Cliënten hoeven absoluut geen applicaties te downloaden of account aan te maken.</p><a href="https://www.samhsa.gov/data/report/nsduh-2024-pst-yr-mhtx-adult-adol" target="_blank" rel="noopener noreferrer" class="inline items-center gap-1 font-medium text-primary-600 hover:text-primary-950 transition-colors text-xs mt-auto tracking-tight pt-2"><!--[-->SAMHSA NSDUH<span>, 2024</span><!--]--><span class="iconify i-ph:arrow-up-right relative transform translate-y-[2px] translate-x-[1px] w-3 h-3" aria-hidden="true" style=""></span></a></div><div class="flex flex-col text-pretty"><span class="text-3xl md:text-5xl text-primary-950 tracking-tight font-[300]">100%</span><h3 class="font-medium text-primary-900 mt-4">Veilig & Versleuteld</h3><p class="text-sm text-primary-700 mt-1">Iedere verbinding in het cliëntportaal is maximaal beveiligd volgens de hoogste normeringen.</p><a href="https://pmc.ncbi.nlm.nih.gov/articles/PMC12096470/" target="_blank" rel="noopener noreferrer" class="inline items-center gap-1 font-medium text-primary-600 hover:text-primary-950 transition-colors text-xs mt-auto tracking-tight pt-2"><!--[-->PMC / a:zorg Congress<span>, 2024</span><!--]--><span class="iconify i-ph:arrow-up-right relative transform translate-y-[2px] translate-x-[1px] w-3 h-3" aria-hidden="true" style=""></span></a></div><!--]--></div></div><!--]--><!----></div><!--]--></section><section class="py-8 md:py-24"><!--[--><div class="w-full max-w-6xl mx-auto px-4 mb-12 md:mb-16"><!--[--><div class="w-full"><div class="flex flex-col items-center text-balance"><div class="flex flex-col items-center text-center"><!----><h2 class="text-100%l md:max-w-[24ch] tracking-tight md:text-4xl font-medium text-primary-950 mb-3">Everything cliënten need, nothing they don&#39;t</h2><p class="text-base text-primary-700 md:max-w-[60ch] text-balance">Alles wat cliënten nodig hebben om zich voor te bereiden op hun afspraak, in één helder overzicht.</p></div><div class="mt-6"><!--[--><a href="/contact" class="cursor-pointer leading-none inline-flex items-center justify-center font-medium transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 whitespace-nowrap px-4 py-3 md:py-3 bg-primary-950 text-primary-50 rounded-full hover:bg-primary-900 focus-visible:ring-primary-950 active:scale-95 text-sm"><!--[-->Neem contact op<!--]--><!----></a><!--]--></div></div></div><!--]--><!----></div><div class="flex flex-col gap-8 md:gap-16 w-full"><div class="w-full max-w-6xl mx-auto px-4"><!--[--><div class="space-y-16 md:space-y-24 w-full"><!--[--><div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-20 items-center"><div class="max-w-md"><span class="inline-block font-medium rounded-full bg-primary-100 text-primary-800 px-3 py-1 text-xs mb-4">Digitale Wachtkamer</span><h3 class="text-xl md:text-100%l font-medium text-primary-950 mb-4 text-pretty">Een warm welkom voor elke afspraak</h3><p class="text-base text-primary-700 text-balance">The portal opens to a conversation. The Digitale Wachtkamer knows each person&#39;s programs and pending Nudges, walks them through check-ins, and answers questions from your own documents. Branded with your organization&#39;s name and avatar.</p><!----></div><figure class=""><div class="bg-primary-100 rounded-xl aspect-[4/3] overflow-hidden"><img data-nuxt-img srcset="/_amplify/image?url=%2Fimages%2Fbeeldzorg_portal_1.jpg&amp;w=1536&amp;q=100 1x, /_amplify/image?url=%2Fimages%2Fbeeldzorg_portal_2.jpg&amp;w=1536&amp;q=100 100%" onerror="this.setAttribute(&#39;data-error&#39;, 1)" alt="Een warm welkom voor elke afspraak" class="w-full h-full object-contain" src="/_amplify/image?url=%2Fimages%2Fbeeldzorg_portal_3.jpg&amp;w=1536&amp;q=100"></div></figure></div><div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-20 items-center"><div class="md:order-2 max-w-md"><span class="inline-block font-medium rounded-full bg-primary-100 text-primary-800 px-3 py-1 text-xs mb-4">Voorbereiding</span><h3 class="text-xl md:text-100%l font-medium text-primary-950 mb-4 text-pretty">Checklisten en formulieren</h3><p class="text-base text-primary-700 text-balance">Voorafgaand aan het videogesprek kunt u cliënten belangrijke documenten of intakeformulieren laten inzien en invullen. Zo bent u beiden goed voorbereid.</p><!----></div><figure class="md:order-1"><div class="bg-primary-100 rounded-xl aspect-[4/3] overflow-hidden"><img data-nuxt-img srcset="/_amplify/image?url=%2Fimages%2Fbeeldzorg_portal_4.jpg&amp;w=1536&amp;q=100 1x, /_amplify/image?url=%2Fimages%2Fbeeldzorg_portal_1.jpg&amp;w=1536&amp;q=100 100%" onerror="this.setAttribute(&#39;data-error&#39;, 1)" alt="Checklisten en formulieren" class="w-full h-full object-contain" src="/_amplify/image?url=%2Fimages%2Fbeeldzorg_portal_2.jpg&amp;w=1536&amp;q=100"></div></figure></div><div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-20 items-center"><div class="max-w-md"><span class="inline-block font-medium rounded-full bg-primary-100 text-primary-800 px-3 py-1 text-xs mb-4">Uw Eigen Huisstijl</span><h3 class="text-xl md:text-100%l font-medium text-primary-950 mb-4 text-pretty">Een professionele uitstraling en vertrouwd gezicht</h3><p class="text-base text-primary-700 text-balance">Custom colors, logos, and branding applied across the entire portal. Login screens, Beeldzorgteam experiences, and portal navigation all carry your practice&#39;s identity.</p><!----></div><figure class=""><div class="bg-primary-100 rounded-xl aspect-[4/3] overflow-hidden"><img data-nuxt-img srcset="/_amplify/image?url=%2Fimages%2Fbeeldzorg_portal_3.jpg&amp;w=1536&amp;q=100 1x, /_amplify/image?url=%2Fimages%2Fbeeldzorg_portal_4.jpg&amp;w=1536&amp;q=100 100%" onerror="this.setAttribute(&#39;data-error&#39;, 1)" alt="Een professionele uitstraling en vertrouwd gezicht" class="w-full h-full object-contain" src="/_amplify/image?url=%2Fimages%2Fbeeldzorg_portal_1.jpg&amp;w=1536&amp;q=100"></div></figure></div><div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-20 items-center"><div class="md:order-2 max-w-md"><span class="inline-block font-medium rounded-full bg-primary-100 text-primary-800 px-3 py-1 text-xs mb-4">Altijd Toegankelijk</span><h3 class="text-xl md:text-100%l font-medium text-primary-950 mb-4 text-pretty">Direct bereikbaar via SMS, e-mail of website</h3><p class="text-base text-primary-700 text-balance">Cliënten openen hun afspraak eenvoudig op hun smartphone, tablet of computer. Het portaal schaalt moeiteloos mee en werkt vlekkeloos in iedere moderne browser.</p><!----></div><figure class="md:order-1"><div class="bg-primary-100 rounded-xl aspect-[4/3] overflow-hidden"><img data-nuxt-img srcset="/_amplify/image?url=%2Fimages%2Fbeeldzorg_portal_2.jpg&amp;w=1536&amp;q=100 1x, /_amplify/image?url=%2Fimages%2Fbeeldzorg_portal_3.jpg&amp;w=1536&amp;q=100 100%" onerror="this.setAttribute(&#39;data-error&#39;, 1)" alt="Direct bereikbaar via SMS, e-mail of website" class="w-full h-full object-contain" src="/_amplify/image?url=%2Fimages%2Fbeeldzorg_portal_4.jpg&amp;w=1536&amp;q=100"></div></figure></div><!--]--></div><!--]--><!----></div></div><!--]--></section><section class="py-8 md:py-24 bg-primary-100/50"><!--[--><div class="w-full max-w-6xl mx-auto px-4"><!--[--><div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-20"><div><div class="w-full"><div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-2 lg:gap-6 text-pretty"><div class="flex flex-col items-start text-left flex-1"><span class="inline-block font-medium rounded-full bg-primary-200 text-primary-900 px-3 py-1 text-xs mb-3">Digitale Wachtkamers</span><h2 class="text-100%l md:max-w-[24ch] tracking-tight md:text-4xl font-medium text-primary-950 mb-3">Geen zorgen over techniek en privacy</h2><p class="text-base text-primary-700 md:max-w-[60ch] text-balance">De Digitale Wachtkamer werkt vanuit uw eigen documenten, geeft deze door aan iemand wanneer dat nodig is en houdt elk gesprek privé. Jij bepaalt wat hij wel en niet mag doen.</p></div><!----></div></div></div><div class="divide-y divide-primary-200"><!--[--><div class="py-5 first:pt-0"><h4 class="font-medium text-primary-950">Volledig AVG Compliant</h4><p class="text-sm text-primary-700 mt-1">We voldoen aan alle Europese privacywetgeving, en slaan geen onnodige patiëntgegevens op in de browser van de cliënt.</p></div><div class="py-5 first:pt-0"><h4 class="font-medium text-primary-950">Toegankelijk voor iedereen</h4><p class="text-sm text-primary-700 mt-1">Het platform is speciaal ontworpen met het oog op laagdrempeligheid, zodat ook ouderen en minder digitaal vaardigen er direct mee overweg kunnen.</p></div><div class="py-5 first:pt-0"><h4 class="font-medium text-primary-950">Geen lokale opslag</h4><p class="text-sm text-primary-700 mt-1">Videobeelden en audio worden uitsluitend via de beveiligde stream verzonden en worden nooit lokaal op het apparaat van de cliënt bewaard.</p></div><div class="py-5 first:pt-0"><h4 class="font-medium text-primary-950">Ondersteuning voor mantelzorgers</h4><p class="text-sm text-primary-700 mt-1">Mantelzorgers of familieleden kunnen eenvoudig, via een veilige gastlink, vanaf hun eigen locatie deelnemen aan het zorggesprek.</p></div><!--]--></div></div><!--]--><!----></div><!--]--></section><section class="py-8 md:py-24"><!--[--><div class="w-full max-w-6xl mx-auto px-4"><!--[--><div class="grid grid-cols-1 md:grid-cols-6 gap-8 md:gap-16 lg:gap-24 items-center"><figure class="order-2 md:col-span-4 space-y-4 md:space-y-6"><blockquote class="text-xl sm:text-100%l lg:text-3xl xl:text-4xl max-w-full sm:max-w-[40ch] font-medium text-primary-900 text-pretty tracking-tight [&amp;_i]:not-italic [&amp;_i]:bg-gradient-to-r [&amp;_i]:from-primary-200/70 [&amp;_i]:to-primary-300/70 [&amp;_i]:px-1 [&amp;_i]:-mx-1 [&amp;_i]:rounded [&amp;_i]:box-decoration-clone [&amp;_i]:border-r-4 [&amp;_i]:border-primary-400">"Our cliënten range from 18 to 75. The portal works for all of them because <i>there is nothing to figure out.</i> They tap a link, see their Beeldzorgteam, and they are done. We have never had a single support request about how to use it."</blockquote><figcaption class="md:order-2"><cite class="text-sm sm:text-base font-medium text-primary-950 not-italic">Ralph Van der Pol</cite><p class="text-xs sm:text-sm text-primary-600">Oprichter Beeldzorgteam</p></figcaption><a href="https://kuduzorg.com" rel="noopener noreferrer" target="_blank" class="inline-block"><img data-nuxt-img srcset="/_amplify/image?url=%2Fimages%2Fkuduzorg-logo.png&amp;w=1536&amp;q=100 1x, /_amplify/image?url=%2Fimages%2Fkuduzorg-logo.png&amp;w=1536&amp;q=100 100%" onerror="this.setAttribute(&#39;data-error&#39;, 1)" alt="Anthony Como company logo" class="h-3 sm:h-4 w-auto transition-opacity hover:opacity-70" src="/_amplify/image?url=%2Fimages%2Fkuduzorg-logo.png&amp;w=1536&amp;q=100"></a></figure><div class="order-1 md:col-span-2"><div class="bg-primary-200 rounded-xl aspect-square md:aspect-auto md:h-full w-full overflow-hidden"><img data-nuxt-img srcset="/_amplify/image?url=%2Fimages%2Fralph-van-der-pol.webp&amp;w=1536&amp;q=100 1x, /_amplify/image?url=%2Fimages%2Fralph-van-der-pol.webp&amp;w=1536&amp;q=100 100%" onerror="this.setAttribute(&#39;data-error&#39;, 1)" alt="Ralph Van der Pol" class="w-full h-full object-cover" src="/_amplify/image?url=%2Fimages%2Fralph-van-der-pol.webp&amp;w=1536&amp;q=100"></div></div></div><!--]--><!----></div><!--]--></section><section class="py-8 md:py-24"><!--[--><div class="w-full max-w-6xl mx-auto px-4"><!--[--><div class="flex flex-col items-center text-center gap-4 lg:gap-8"><h2 class="text-4xl lg:text-6xl tracking-tight text-balance font-medium text-pr